# streamed-m3u configuration
#
# Copy this file to .env next to docker-compose.yml and fill in the values you
# need. Every line below is optional except where marked required.
#
# Precedence, highest first:
#   1. /data/settings.json  written by the console when editing is enabled
#   2. this environment     compose, .env, or your platform's app config
#   3. built-in defaults
# The console shows which layer each value came from. An empty value counts as
# unset. PORT, TEAMS_FILE, EXTRACT_CACHE_FILE, LINEUP_FILE, DATA_DIR,
# CONSOLE_PASSWORD, PUID and PGID are environment-only and never written to
# the settings file.

# ── Compose ─────────────────────────────────────────────────────────────────
# Image to run. Build locally or pull a published tag.
#STREAMED_M3U_IMAGE=streamed-m3u:latest
# Host directory that holds each service's persistent data.
#CONFIG_DIR=./config
# User and group the service runs as inside the container. TrueNAS SCALE
# apps conventionally use 568.
#PUID=1000
#PGID=1000
# Host ports.
#STREAMED_M3U_PORT=8787
#DISPATCHARR_PORT=9191
#TZ=UTC

# ── VPN (gluetun) ───────────────────────────────────────────────────────────
# Required unless you use docker-compose.novpn.yml.
#VPN_SERVICE_PROVIDER=airvpn
#VPN_TYPE=wireguard
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_PRESHARED_KEY=
#WIREGUARD_ADDRESSES=
#SERVER_COUNTRIES=United States

# ── Console ─────────────────────────────────────────────────────────────────
# Set a password to enable editing settings from the browser. Leave unset for
# a read-only console with no login.
#CONSOLE_PASSWORD=
# Send Secure cookies. Only enable behind HTTPS.
#CONSOLE_COOKIE_SECURE=0

# ── Dispatcharr sync container ──────────────────────────────────────────────
# Required for the streamed-m3u-sync service.
#DISPATCHARR_USER=
#DISPATCHARR_PASS=
# Exact names of the M3U account and EPG source you created in Dispatcharr.
#M3U_ACCOUNT_NAME=streamed.pk teams
#EPG_SOURCE_NAME=streamed.pk teams EPG
# Seconds between sync cycles.
#SYNC_INTERVAL=480
# streamed-m3u base URL the sync container uses for /teams?all=1.
#STREAMED_M3U_URL=http://gluetun:8787

# ── Service ───────────────────────────────────────────────────────────────────
# Port the service binds. Must match the published container port. (environment only)
# Range 1 to 65535.
#PORT=8787
# Address clients use to reach this service, used in every playlist URL. Empty means derive it from each request, which is right on a shared network. (applies: live)
#PUBLIC_BASE_URL=
# Logging verbosity. Also sets what reaches the events panel. (applies: live)
# One of: DEBUG, INFO, WARNING, ERROR.
#LOG_LEVEL=INFO
# Pause before the first scrape, giving the VPN tunnel time to come up. (applies: restart)
# Range 0 to 300.
#STARTUP_DELAY=15
# Roster file. The only irreplaceable state the service holds. (environment only)
#TEAMS_FILE=/data/teams.json
# Where resolved stream URLs are persisted across restarts. (environment only)
#EXTRACT_CACHE_FILE=/data/extract_cache.json
# Jellyfin allowlist file. Missing means the bundled default set is installed. (environment only)
#LINEUP_FILE=/data/lineup.json

# ── Upstream ──────────────────────────────────────────────────────────────────
# Catalog the service scrapes. Change this when the site moves domain. (applies: live)
#STREAMED_BASE_URL=https://streamed.pk
# Extra web addresses for the catalog, tried in order if the main one is down. Only addresses listed here (and the main one) are ever contacted. (applies: live)
#STREAMED_MIRRORS=
# ppv.st API the service lists games from. Change this when it moves domain. (applies: live)
#PPV_BASE_URL=https://api.ppv.st
# Extra web addresses for the ppv.st API, tried in order if the main one is down. Only addresses listed here (and the main one) are ever contacted. (applies: live)
#PPV_MIRRORS=
# streamfree API the service lists games from. Change this when it moves domain. (applies: live)
#STREAMFREE_BASE_URL=https://streamfree.top
# Extra web addresses for the streamfree API, tried in order if the main one is down. Only addresses listed here (and the main one) are ever contacted. (applies: live)
#STREAMFREE_MIRRORS=
# Address of streamfree's embed pages, which differs from its API. A link in the game list on any other address is moved onto this one. (applies: live)
#STREAMFREE_EMBED_BASE_URL=https://strmfree.st
# Extra addresses for streamfree's embed pages. Links on these are used as listed; no other embed address is ever used. (applies: live)
#STREAMFREE_EMBED_MIRRORS=
# Which services supply games and streams, in preference order. Known names: streamfree, ppv, streamed (closed in October 2026). Unknown names are ignored. (applies: live)
#PROVIDERS=streamfree, ppv
# Hours a service whose game list fails is still served from its last good list. Past this its games drop out of the playlist; Channels are never removed because of a failed fetch. (applies: live)
# Range 0 to 168.
#PROVIDER_STALE_HOURS=6.0
# Seconds before an upstream API call is abandoned. (applies: live)
# Range 1 to 120.
#REQUEST_TIMEOUT=10
# Parallel workers for a playlist build. Modest values avoid rate limits. (applies: live)
# Range 1 to 32.
#BUILD_WORKERS=8
# Interval between playlist rebuilds. A change waits out the current interval. (applies: live)
# Range 60 to 86400.
#REFRESH_SECONDS=480

# ── Channels ──────────────────────────────────────────────────────────────────
# Favourites kept hot. Each costs one serial browser launch, so keep it short. (applies: restart)
#PREWARM_TEAMS=
# Extra names granted away-side resolution. Adds to the built-in league list. (applies: restart)
#EXTRA_ALIAS_TEAMS=
# Racing series that keep a permanent channel through the off-season. (applies: restart)
#SERIES_CHANNELS=Formula 1, IndyCar, Nascar Cup Series, Nascar Truck Series, MotoGP, Moto2, Moto3, World Rally Championship
# Always-on feeds, named by the title they display under. (applies: next-refresh)
#FEED_CHANNELS=Rally TV, Tennis Channel, Willow Cricket, Fox League, NFL RedZone, NFL Network
# Shared channels for one-off events. Lowering it never removes existing channels. (applies: next-refresh)
# Range 0 to 16.
#POOL_SLOTS=4
# Display name for the shared event slots. Renaming mints new channels; the old ones stay. (applies: restart)
#POOL_NAME=Live Event
# Group title favourites are filed under in the playlist. (applies: live)
#FAVOURITES_GROUP=Favorites

# ── Multi-view ────────────────────────────────────────────────────────────────
# Composite channels carrying two fixtures at once. Off means no slots are created and nothing can start an encoder. (applies: restart)
#MULTIVIEW_ENABLE=off
# Composite channels to create. Each is a permanent shelf; only MULTIVIEW_MAX_ACTIVE of them may run at once. (applies: restart)
# Range 0 to 4.
#MULTIVIEW_SLOTS=2
# Display name for the composite slots. Renaming mints new channels; the old ones stay. (applies: restart)
#MULTIVIEW_NAME=Multi-Player
# Composites allowed to run at once. One encode costs roughly a third of a four-core box, so raising this needs headroom to spare. (applies: live)
# Range 1 to 4.
#MULTIVIEW_MAX_ACTIVE=1
# Encoder for the composite. vaapi uses the Intel iGPU and needs the render node passed in; cpu is the fallback and is much more expensive. (applies: restart)
# One of: vaapi, cpu.
#MULTIVIEW_ENCODER=vaapi
# Composite quality, lower is better. A quantiser rather than a bitrate because the Intel driver here offers no other rate control. (applies: live)
# Range 1 to 51.
#MULTIVIEW_QP=23
# Seconds with no viewer before a composite shuts down. An encoder must never outlive its audience. (applies: live)
# Range 5 to 3600.
#MULTIVIEW_IDLE_TIMEOUT=60
# Seconds a cold composite may pad the wire before it is given up on. Both sources resolve one after the other, so this is several times one channel's cascade budget rather than comparable to it. (applies: live)
# Range 10 to 600.
#MULTIVIEW_START_TIMEOUT=90
# How many times one viewing may rebuild its encoder before the stream ends. Changing either channel costs one, and so does a source that dies; needing more than a few means something is wrong. (applies: live)
# Range 0 to 50.
#MULTIVIEW_REATTACHES=8
# Which fixtures each composite slot points at. (environment only)
#MULTIVIEW_FILE=/data/multiview.json
# Render node used by the vaapi encoder. The container also needs the host's render group, or opening this fails as 'no VA display found'. (environment only)
#MULTIVIEW_RENDER_NODE=/dev/dri/renderD128
# Where the pipes carrying each composite's two inputs are created. Holds no state; a tmpfs is the right home for it. (environment only)
#MULTIVIEW_FIFO_DIR=/dev/shm/streamed-m3u

# ── Pre-warm ──────────────────────────────────────────────────────────────────
# How often the pre-warm loop looks for work. (applies: live)
# Range 10 to 3600.
#PREWARM_INTERVAL=60
# Ceiling on the warm list, favourites and multi-view sources together. Warming is serial at 20-25s per entry, so twelve is already a five-minute cycle; multi-view sources are kept when it has to cut. (applies: live)
# Range 1 to 40.
#PREWARM_MAX_ENTRIES=12
# Re-warm once a cached entry drops below this much remaining TTL. (applies: live)
# Range 0 to 86400.
#PREWARM_MARGIN=120
# Minutes before kickoff that a fixture becomes eligible for warming. (applies: live)
# Range 0 to 1440.
#PREWARM_WINDOW_BEFORE=20
# Minutes after kickoff that a fixture stays eligible for warming. (applies: live)
# Range 0 to 1440.
#PREWARM_WINDOW_AFTER=300

# ── Resolution ────────────────────────────────────────────────────────────────
# Ceiling on one headless extraction attempt. (applies: live)
# Range 5 to 120.
#BROWSER_TIMEOUT=15
# Wall-clock ceiling for trying sources. Must stay below Dispatcharr's 60 second grace period. (applies: live)
# Range 10 to 59.
#CASCADE_BUDGET=55
# Hard cap on attempts, independent of the time budget. (applies: live)
# Range 1 to 9.
#CASCADE_MAX_ATTEMPTS=4
# Headroom required before a further attempt is allowed to start. (applies: live)
# Range 0 to 59.
#CASCADE_RESERVE=20
# How long a resolved stream URL stays reusable. (applies: live)
# Range 30 to 86400.
#EXTRACT_CACHE_TTL=300
# Cache size cap. Oldest entries evict first. Zero means no cap. (applies: live)
# Range 0 to 10000.
#EXTRACT_CACHE_MAX_ENTRIES=100
# Reject a source carrying no audio track and fall through to the next. (applies: live)
#REQUIRE_AUDIO=on
# How long a confirmed silent source is remembered, so it is not retried. (applies: live)
# Range 0 to 86400.
#NO_AUDIO_TTL=1800

# ── Playback ──────────────────────────────────────────────────────────────────
# Per-chunk download ceiling. Must stay above the time a healthy chunk takes. (applies: live)
# Range 5 to 300.
#SEGMENT_TIMEOUT=30
# Same ceiling for the startup liveness probe. Raising it costs cascade budget. (applies: live)
# Range 1 to 300.
#SEGMENT_PROBE_TIMEOUT=20
# Extra attempts for a failed chunk. Small on purpose: retries drag the live edge. (applies: live)
# Range 0 to 5.
#SEGMENT_RETRIES=1
# Sanity cap on a buffered chunk, since chunks are held in RAM before forwarding. (applies: live)
# Range 1 to 512.
#SEGMENT_MAX_MB=64
# Reach stream sources over IPv4 only. Behind the VPN, an IPv6 lookup costs about 2s per request and the IPv6 route bypasses the tunnel. (applies: live)
#UPSTREAM_IPV4=on
# After chunks go missing, move the timestamps of the next chunk and every later one back by the missing span, so Jellyfin's audio stays in step with the picture. Off: chunks are sent exactly as they came. (applies: live)
#HOLE_RESTAMP=on
# Shortest missing span that is restamped. ffmpeg's own jump threshold is 10s; shorter holes stay byte passthrough. (applies: live)
# Range 1 to 60.
#HOLE_RESTAMP_MIN_S=8.0
# Play about this many seconds behind live: a stream starts at the oldest chunk the source's playlist still offers, up to this far back, and stays in order after a stall. The playlist window (about 12-20s on the sources seen) caps it. 0: no limit, the whole window, as before. (applies: live)
# Range 0 to 300.
#BEHIND_LIVE_S=30.0
# Send null-packet padding while a playlist request is running, as is already done during chunk downloads, so Dispatcharr does not see silence. Makes no video. Off: nothing is sent during the request. (applies: live)
#PLAYLIST_KEEPALIVE=on
# When a chunk's last attempt is refused with HTTP 403, read the playlist again and try the chunk once more, but only if the playlist now lists a different link. Costs one playlist request per refused chunk and at most one segment timeout of extra work a minute per stream. Off: the two attempts, then the hole, as before. (applies: live)
#FRESH_LINK_RETRY=on
# Seconds without a new segment before a stream is treated as dead. (applies: live)
# Range 5 to 600.
#STREAM_IDLE_TIMEOUT=45
# Seconds between null packets sent while waiting on a slow chunk, so the client does not give up. (applies: live)
# Range 0 to 30.
#STREAM_KEEPALIVE_INTERVAL=1.0
# Segment URLs remembered per stream, bounding memory on long sessions. (applies: live)
# Range 10 to 10000.
#STREAM_SEEN_MAX=300

# ── Guide ─────────────────────────────────────────────────────────────────────
# How far ahead the guide publishes. (applies: live)
# Range 1 to 168.
#EPG_WINDOW_HOURS=24
# How far back the guide reaches, so in-progress matches still appear. (applies: live)
# Range 0 to 48.
#EPG_BACKFILL_HOURS=6
# Assumed programme length for sports with no per-sport duration. (applies: live)
# Range 10 to 1440.
#EPG_DEFAULT_MINUTES=180

# ── Logos ─────────────────────────────────────────────────────────────────────
# How long a successfully fetched logo is served from cache. (applies: live)
# Range 0 to 604800.
#LOGO_CACHE_TTL=86400
# Short retry window after a logo fetch fails. (applies: live)
# Range 0 to 86400.
#LOGO_CACHE_FAIL_TTL=60
# Logo cache size cap. (applies: live)
# Range 0 to 100000.
#LOGO_CACHE_MAX_ENTRIES=500
